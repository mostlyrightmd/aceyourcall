{
  "name": "aceyourcall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "check:secrets": "python3 scripts/leak-check.py",
    "setup": "python3 selfhost/setup.py",
    "build": "tsc --noEmit && vite build",
    "start:calls": "node src/call-server.js",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/room-links.browser.mjs && node tests/react-flow.browser.mjs && node tests/engine-lifecycle.browser.mjs && node tests/named-captions.browser.mjs && node tests/room-access.browser.mjs",
    "ui:review": "node scripts/ui-review.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tabler/icons-react": "^3.50.0",
    "get-nonce": "^1.0.1",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mostlyrightmd/aceyourcall.git"
  }
}
